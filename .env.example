# Copy to .env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
APP_NAME=AI Tutor Dashboard
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
# Used to sign access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Base URL used in password-reset emails
FRONTEND_URL=http://localhost:5173

# --- Auth ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# --- Database (docker-compose service) ---
POSTGRES_USER=aitutor
POSTGRES_PASSWORD=aitutor_dev_password
POSTGRES_DB=aitutor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (AI tutor) ---
# auto = Anthropic when ANTHROPIC_API_KEY is set, otherwise a clearly labelled mock provider.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
LLM_MODEL_TUTOR=claude-opus-5-5
LLM_MODEL_STRUCTURED=claude-opus-5-5
# Thinking depth / cost: low | medium | high | xhigh | max
LLM_EFFORT_TUTOR=medium
LLM_EFFORT_STRUCTURED=medium
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=60

# --- Speech (Phase 5+) ---
STT_PROVIDER=mock
TTS_PROVIDER=mock
# Gnani placeholders. These are NOT confirmed Gnani API specifications.
# Real integration is implemented only after the official documentation is provided.
GNANI_API_KEY=
GNANI_API_BASE_URL=
GNANI_STT_ENABLED=false
GNANI_TTS_ENABLED=false

# --- Email (Phase 3, optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Media storage ---
MEDIA_ROOT=./media

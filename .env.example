# Copy to .env and fill in values. Never commit .env.

# --- App ---
APP_ENV=development
APP_NAME=AI Tutor Dashboard
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173
# Used to sign access tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
# Base URL used in password-reset emails
FRONTEND_URL=http://localhost:5173

# --- Auth ---
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=60

# --- Database (docker-compose service) ---
POSTGRES_USER=aitutor
POSTGRES_PASSWORD=aitutor_dev_password
POSTGRES_DB=aitutor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- LLM (AI tutor) ---
# auto = Anthropic when ANTHROPIC_API_KEY is set, else Groq when GROQ_API_KEY is set,
# otherwise a clearly labelled mock provider. Or force one: anthropic | groq | mock
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
GROQ_API_KEY=
# Optional: a separate key for Video Studio scripts (defaults to GROQ_API_KEY).
# Groq limits are per account, so two keys from one account share the same limits.
GROQ_VIDEO_API_KEY=
# Groq models (structured output needs strict json_schema support, e.g. openai/gpt-oss-*).
GROQ_MODEL_TUTOR=openai/gpt-oss-120b
GROQ_MODEL_STRUCTURED=openai/gpt-oss-120b
LLM_MODEL_TUTOR=claude-opus-5-5
LLM_MODEL_STRUCTURED=claude-opus-5-5
# Thinking depth / cost: low | medium | high | xhigh | max
LLM_EFFORT_TUTOR=medium
LLM_EFFORT_STRUCTURED=medium
AI_RATE_LIMIT=20
AI_RATE_WINDOW_SECONDS=60

# --- Speech (Phase 5+) ---
# mock | gnani
STT_PROVIDER=mock
TTS_PROVIDER=mock
# Gnani (Vachana) speech, per https://docs.gnani.ai. Empty base URL = https://api.vachana.ai
GNANI_API_KEY=
GNANI_API_BASE_URL=
GNANI_STT_ENABLED=false
GNANI_TTS_ENABLED=false
GNANI_TTS_MODEL=timbre-v2.5
# Upload / text limits and rate limit for the speech endpoints.
SPEECH_MAX_AUDIO_BYTES=10485760
SPEECH_MAX_TTS_CHARS=2000
SPEECH_RATE_LIMIT=30
SPEECH_RATE_WINDOW_SECONDS=60

# --- Email (Phase 3, optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Media storage ---
MEDIA_ROOT=./media

# --- Video generation (worker: docker compose --profile video up -d video-worker) ---
# l = 480p (fast), m = 720p, h = 1080p
VIDEO_QUALITY=m
VIDEO_JOB_TIMEOUT_SECONDS=1200
VIDEO_RATE_LIMIT=5
VIDEO_RATE_WINDOW_SECONDS=3600
MEDIA_URL_TTL_SECONDS=3600

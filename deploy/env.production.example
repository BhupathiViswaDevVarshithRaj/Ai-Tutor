# Production settings. deploy/setup-env.sh copies this to .env and fills in the secrets marked
# GENERATED. Put your own API keys in by editing .env on the server (nano .env); never commit it.

# --- Site ---
DOMAIN=                       # e.g. aitutor-yourname.duckdns.org
ACME_EMAIL=                   # for the HTTPS certificate's expiry notices
# Optional: keep the DuckDNS name pointing here (see DEPLOYMENT.md)
DUCKDNS_SUBDOMAIN=            # e.g. aitutor-yourname (without .duckdns.org)
DUCKDNS_TOKEN=

# --- Secrets (GENERATED by setup-env.sh) ---
SECRET_KEY=GENERATED
POSTGRES_PASSWORD=GENERATED
POSTGRES_USER=aitutor
POSTGRES_DB=aitutor

# --- AI ---
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_VIDEO_API_KEY=           # optional; defaults to GROQ_API_KEY
ANTHROPIC_API_KEY=

# --- Speech (Gnani) ---
STT_PROVIDER=gnani
TTS_PROVIDER=gnani
GNANI_API_KEY=
GNANI_STT_ENABLED=true
GNANI_TTS_ENABLED=true

# --- Video and pictures ---
VIDEO_QUALITY=m
MEDIA_CONTACT=                # a website or email Wikimedia can reach you at (their policy)

# --- Email for password resets (optional; without it the reset link is only logged) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Server size ---
API_WORKERS=2

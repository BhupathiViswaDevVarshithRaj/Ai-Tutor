# Copy to .env.cloud-worker (git-ignored) for the video worker that renders for the Render deploy:
#   docker compose --profile cloud-worker up -d --build video-worker-cloud
# Values come from the Render dashboard (external connection details, not the internal ones).

# Postgres -> ai-tutorrr-db -> Connect -> External Database URL:
#   postgresql://USER:PASSWORD@HOST/DATABASE
POSTGRES_HOST=dpg-xxxxxxxx-a.singapore-postgres.render.com
POSTGRES_PORT=5432
POSTGRES_DB=aitutor
POSTGRES_USER=aitutor
POSTGRES_PASSWORD=

# Key Value -> ai-tutorrr-redis -> Connect -> External URL (rediss://...).
# External access must be allowed under Networking first.
REDIS_URL=rediss://red-xxxxxxxx:PASSWORD@singapore-keyvalue.render.com:6379

# Writes the video scripts (same as the API's key; GROQ_VIDEO_API_KEY is optional).
GROQ_API_KEY=
GROQ_VIDEO_API_KEY=
LLM_PROVIDER=auto
STT_PROVIDER=mock
TTS_PROVIDER=mock

# 480p keeps videos small: the free database holds 1 GB.
VIDEO_QUALITY=l
